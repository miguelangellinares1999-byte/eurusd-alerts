# Copia este fichero a .env y rellénalo. .env NO debe subirse a git.

# Cuenta Gmail que envía y contraseña de aplicación (16 caracteres, no tu contraseña normal)
SMTP_USER=tu_cuenta@gmail.com
SMTP_APP_PASSWORD=abcd efgh ijkl mnop
# Destinatarios separados por comas
ALERT_TO=tu_cuenta@gmail.com

# Solo si data_source.type = mt5 (opcional: sin ellos usa el terminal ya abierto y logueado)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
